  object sql: TFDQuery
    FilterOptions = [foCaseInsensitive]
    FetchOptions.AssignedValues = [evMode]
    FetchOptions.Mode = fmAll
    SecurityOptions.AllowedCommandKinds = [skUnknown, skSelect, skSelectForLock, skSelectForUnLock, skStoredProc, skStoredProcWithCrs, skStoredProcNoCrs, skExecute, skStartTransaction, skCommit, skRollback, skSet, skSetSchema, skOther, skNotResolved]
    SQL.Strings = (
      'select'
      #9'c.Id,'
      
        #9'convert(cast(convert(c.Nome using latin1) as binary) using utf8' +
        ') "Cliente",'
      
        #9'convert(cast(convert(a.Pessoa using latin1) as binary) using ut' +
        'f8) "Solicitante",'
      #9'a.`Data` "DataAbertura",'
      #9'a.Hora "HoraAbertura",'
      #9'a.DataFechamento,'
      #9'a.HoraFechamento,'
      
        #9'convert(cast(convert(a.Historico using latin1) as binary) using' +
        ' utf8) "Historico",'
      
        #9'convert(cast(convert(u.Nome using latin1) as binary) using utf8' +
        ') "Analista",'
      #9'('
      #9'select'
      #9#9'COUNT(a2.id)'
      #9'from'
      #9#9'atendimentos a2'
      #9'where'
      #9#9'a2.UserAtribuido = a.UserAtribuido'
      #9#9'and a2.DataFechamento between :datainicial and :datafinal'
      #9#9'and a2.Fechado = '#39'S'#39') as "TotalPorAnalista",'
      
        #9'convert(cast(convert(c.Sistema using latin1) as binary) using u' +
        'tf8) "Sistema",'
      
        #9'convert(cast(convert(a.categoria using latin1) as binary) using' +
        ' utf8) "Categoria",'
      
        #9'convert(cast(convert(cel.celula using latin1) as binary) using ' +
        'utf8) "Setor"'
      'from'
      #9'atendimentos a'
      'inner join clientes c on'
      #9'c.id = a.cliente'
      'inner join usuarios u on'
      #9'u.Id = a.UserAtribuido'
      'left join celulas cel on'
      #9'cel.id = a.setor'
      'where'
      #9'a.DataFechamento between :datainicial and :datafinal'
      #9'and a.Fechado = '#39'S'#39
      ' '
      
        'order by TotalPorAnalista desc, a.UserAtribuido, a.Cliente, a.Da' +
        'taFechamento, a.HoraFechamento')
    Left = 504
    Top = 320
    ParamData = <
      item
        Name = 'DATAINICIAL'
        DataType = ftDate
        ParamType = ptInput
        Value = 46082d
      end
      item
        Name = 'DATAFINAL'
        DataType = ftDate
        ParamType = ptInput
        Value = 46092d
      end>
